---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero-band hero-band--compact" id="home">
	<div class="hero-container hero-container--single">
		<div class="hero-content">
			<p class="hero-greeting">{t.hero.greeting}</p>
			<h1 class="hero-title">{t.hero.name}</h1>
			<p class="hero-tagline">{t.hero.tagline}</p>

			<div class="hero-actions">
				<button type="button" class="btn btn-primary" data-open-projects-modal>
					{t.hero.ctaProjects}
				</button>
				<a class="btn btn-secondary" href="https://tgs.gamer.gd/" target="_blank" rel="noopener noreferrer">
					{t.hero.ctaTgs}
				</a>
				<a
					class="btn btn-secondary"
					href="https://github.com/T1NG4"
					target="_blank"
					rel="noopener noreferrer">{t.hero.ctaGithub}</a
				>
			</div>
		</div>
	</div>
</section>
