---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import SectionTitle from './SectionTitle.astro';
import StackSection from './StackSection.astro';
import TgsLeadCard from './TgsLeadCard.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section-band section-muted section-spacious" id="projects">
	<div class="container">
		<SectionTitle kicker={t.projects.kicker} title={t.projects.title} lead={t.projects.lead} />
		<TgsLeadCard lang={lang} />
		<p class="projects-modal-cta reveal">
			<button type="button" class="btn btn-outline" data-open-projects-modal>
				{t.modal.openAll}
			</button>
		</p>
	</div>
</section>

<StackSection lang={lang} />

<section class="section-band section-spacious" id="about">
	<div class="container">
		<SectionTitle kicker={t.about.kicker} title={t.about.title} />
		<p class="prose prose-left reveal">{t.about.body}</p>
	</div>
</section>

<section class="section-band section-muted section-spacious" id="contact">
	<div class="container">
		<SectionTitle kicker={t.contact.kicker} title={t.contact.title} lead={t.contact.body} />
		<div class="contact-links reveal">
			<a
				class="btn btn-primary"
				href="https://github.com/T1NG4"
				target="_blank"
				rel="noopener noreferrer">{t.contact.github}</a
			>
			<a
				class="btn btn-outline"
				href="https://discord.com/users/871460606618767360"
				target="_blank"
				rel="noopener noreferrer">{t.contact.discord}</a
			>
		</div>
	</div>
</section>
