---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-content">
		<div class="footer-brand">
			<img src="/tgs/TGS_logo.svg" alt="TGS" class="footer-logo" width="36" height="36" />
			<p>T1NG4 · {t.footer.builtWith}</p>
		</div>
		<div class="footer-links">
			<a href="https://tgs.gamer.gd/" rel="noopener noreferrer">TGS Community</a>
			<a href="https://github.com/T1NG4" rel="noopener noreferrer">GitHub</a>
			<a
				href="https://chromewebstore.google.com/detail/ripper-search/hnofnogigohohmhnbjokglneeeignolj"
				rel="noopener noreferrer">Ripper Search</a
			>
			<a href={lang === 'en' ? '/en/#projects' : '/#projects'}>{t.nav.projects}</a>
		</div>
	</div>
	<div class="container footer-bottom">
		<span>© {year} T1NG4. {t.footer.rights}</span>
	</div>
</footer>
