---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container inner">
		<span>© {year} T1NG4 · {t.footer.builtWith}</span>
		<div class="footer-links">
			<a href="https://github.com/T1NG4" rel="noopener noreferrer">GitHub</a>
			<a
				href="https://chromewebstore.google.com/detail/ripper-search/hnofnogigohohmhnbjokglneeeignolj"
				rel="noopener noreferrer">Chrome Web Store</a
			>
			<a href={lang === 'en' ? '/en/#projects' : '/#projects'} rel="noopener noreferrer"
				>{t.nav.projects}</a
			>
		</div>
	</div>
</footer>
