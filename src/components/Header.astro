---
import type { Lang } from '../i18n/ui';
import { homePath, useTranslations } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);
const prefix = lang === 'en' ? '/en' : '';
const otherPath = homePath(lang === 'pt' ? 'en' : 'pt');
---

<header class="site-header" id="siteHeader">
	<nav class="nav-container">
		<a class="logo" href={home}>
			<img src="/tgs/TGS_logo.svg" alt="" class="logo-img logo-on-dark" width="40" height="40" />
			<img src="/tgs/TGS_logo_black.svg" alt="" class="logo-img logo-on-light" width="40" height="40" />
			<span class="logo-text">T1NG4</span>
		</a>
		<div class="nav-links">
			<a href={`${prefix}/#projects`}>{t.nav.projects}</a>
			<a href={`${prefix}/#stack`}>{t.nav.stack}</a>
			<a href={`${prefix}/#about`}>{t.nav.about}</a>
			<a href={`${prefix}/#contact`}>{t.nav.contact}</a>
			<a class="lang-link" href={otherPath}>{t.footer.langSwitch}</a>
		</div>
	</nav>
</header>

<script>
	const header = document.getElementById('siteHeader');
	if (header) {
		const hero = document.getElementById('home');
		const sync = () => {
			const heroBottom = hero ? hero.getBoundingClientRect().bottom : 0;
			header.classList.toggle('header--light', heroBottom < 80);
		};
		sync();
		window.addEventListener('scroll', sync, { passive: true });
		window.addEventListener('resize', sync);
	}
</script>
