---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { localizedProjectPath, useTranslations } from '../i18n/ui';

interface Props {
	project: Project;
	lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const detailPath = localizedProjectPath(lang, project.slug);
---

<article class="project-card reveal" style={`--glow: ${project.accent}`}>
	<span class="project-card-kicker">{project.kicker[lang]}</span>
	<h3>{project.title[lang]}</h3>
	<p>{project.summary[lang]}</p>

	<div class="chips">
		{project.stack.map((item) => <span class="chip">{item}</span>)}
	</div>

	{
		project.showReleaseBadges && (
			<div class="featured-badges">
				<img
					src={`https://img.shields.io/github/v/release/${project.repo}?include_prereleases&label=release&style=flat-square&color=7c5cff`}
					alt=""
					loading="lazy"
					width="120"
					height="20"
				/>
			</div>
		)
	}

	<a class="card-link" href={detailPath}>{t.project.viewDetails} <span>→</span></a>
</article>
